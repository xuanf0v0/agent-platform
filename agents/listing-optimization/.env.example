# Place values in project-root .env (gitignored) or export them in the server process.
# OpenAI-compatible API (DeepSeek defaults; not required when MOCK=true)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com
WRITER_MODEL=deepseek-v4-flash
REVIEW_MODEL=deepseek-v4-flash
VOTE_MODEL=deepseek-v4-flash

# Runtime flags
MOCK=false
TITLE_MODE=sop_seo
HITL_CONFIRM=false
LOCALE=en

# Hard runtime budgets (server-side only)
MAX_LLM_CALLS=12
MAX_MCP_CALLS=20
RUN_DEADLINE_SECONDS=120
MAX_REVIEW_ROUNDS=2
EDITORIAL_SHADOW_ENABLED=true

# Checkpoint persistence (server-side only)
CHECKPOINT_RETENTION_HOURS=24
CHECKPOINT_PATH=.amazon_copy/checkpoints.sqlite3

# Remote MCP providers (optional; leave empty to keep fixture/mock path)
# listing-optimize specialized rule Resources (optional; HTTPS URL and Bearer token stay server-side)
LISTING_OPTIMIZE_MCP_URL=
LISTING_OPTIMIZE_MCP_TOKEN=
LISTING_OPTIMIZE_MCP_TIMEOUT_SECONDS=10
LISTING_OPTIMIZE_MCP_MAX_RESOURCE_BYTES=64000
LISTING_OPTIMIZE_MCP_MAX_PAGES=16
# SellerSprite: header secret-key (or ?secret-key= on URL)
SELLERSPRITE_MCP_KEY=
SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp
# Sorftime: ?key= query (or Authorization: Bearer)
SORFTIME_MCP_KEY=
SORFTIME_MCP_URL=https://mcp.sorftime.com
# SIF: header secret-key
SIF_MCP_KEY=
SIF_MCP_URL=https://mcp.sif.com/mcp

# Optional writing MCPs (stdio) — style/grammar only; never product-fact authority
# writing-tools-mcp: spellcheck, readability, passive voice, keyword density
WRITING_TOOLS_MCP_ENABLED=false
WRITING_TOOLS_MCP_COMMAND=uvx --from git+https://github.com/wdm0006/writing-tools-mcp writing-tools-mcp
# that's boring Writing Editor MCP: clarity metrics + optional polish pass
WRITING_EDITOR_MCP_ENABLED=false
WRITING_EDITOR_MCP_COMMAND=npx --yes tsx .vendor/thatsboring/writing-editor-mcp/src/server.ts
# When true, run editor polish on optimized fields then re-postflight (fact gates still win)
WRITING_EDITOR_MCP_POLISH=false
WRITING_MCP_TIMEOUT_SECONDS=20
