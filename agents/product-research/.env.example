# Model and MCP credentials are inherited read-only from, in priority order:
# ../listing-optimization/.env, then ../listing-creation/.env.
# Do not duplicate secrets in this file.
PRODUCT_RESEARCH_MCP_TIMEOUT_SECONDS=35

PRODUCT_RESEARCH_MAX_MCP_CALLS=60
PRODUCT_RESEARCH_MAX_LLM_CALLS=4
PRODUCT_RESEARCH_DEADLINE_SECONDS=300
PRODUCT_RESEARCH_CHECKPOINT_PATH=.product_research/runs.sqlite3
