# Server-side only. Never put keys in the browser.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com
WRITER_MODEL=deepseek-v4-flash
REVIEW_MODEL=deepseek-v4-flash
# Required only when uploaded images need visual analysis; must support image input.
VISION_MODEL=
MOCK=false

# Optional live MCP (priority-6 market context only)
SELLERSPRITE_MCP_KEY=
SORFTIME_MCP_KEY=
SIF_MCP_KEY=

# Optional provider endpoints; defaults are trusted official MCP hosts.
# SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp
# SORFTIME_MCP_URL=https://mcp.sorftime.com
# SIF_MCP_URL=https://mcp.sif.com/mcp
